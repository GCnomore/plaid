# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=
PLAID_ENV=production

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEYS={"default":"YOUR_SERVICE_ROLE_KEY"}

# Budget (optional — defaults shown)
WEEKLY_BUDGET=350
BUDGET_TIMEZONE=America/Los_Angeles

# Slack (only needed with --notify)
SLACK_WEBHOOK_URL=

# Manual sync tuning (optional)
REFRESH_WAIT_MS=5000
SYNC_RETRY_COUNT=3
SYNC_RETRY_WAIT_MS=5000
